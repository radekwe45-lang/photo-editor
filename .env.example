# Aperture — image generation / edit backend
# Default: mock mode (no keys needed). UI remains fully demoable.

MOCK_IMAGE_API=true

# When MOCK_IMAGE_API=false, set a reachable image-edit API base URL.
# Examples:
#   OpenAI-compatible: https://api.openai.com/v1
#   Local SD WebUI (A1111) proxy / OpenAI-compat shim: http://127.0.0.1:7860
#   ComfyUI custom proxy: http://127.0.0.1:8188
IMAGE_API_BASE_URL=

# Optional bearer / API key forwarded as Authorization: Bearer <key>
IMAGE_API_KEY=

# Optional path override relative to IMAGE_API_BASE_URL (default: /images/edits)
# IMAGE_API_EDIT_PATH=/images/edits
